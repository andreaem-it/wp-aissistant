{
  "name": "@wp-aissistant/browser",
  "version": "0.1.0",
  "description": "SDK browser headless di WP AIssistant: chat RAG, streaming SSE, lead form e web component isolato in Shadow DOM.",
  "license": "MIT",
  "author": "WP AIssistant",
  "type": "module",
  "types": "./src/index.d.ts",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "unpkg": "./src/index.js",
  "jsdelivr": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./widget": {
      "types": "./src/widget.d.ts",
      "default": "./src/widget.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreaem-it/wp-aissistant.git",
    "directory": "sdk/browser"
  },
  "homepage": "https://github.com/andreaem-it/wp-aissistant/blob/main/docs/browser-sdk.md",
  "bugs": {
    "url": "https://github.com/andreaem-it/wp-aissistant/issues"
  },
  "keywords": [
    "wp-aissistant",
    "chatbot",
    "customer-support",
    "rag",
    "sse",
    "web-component",
    "headless",
    "woocommerce"
  ],
  "scripts": {
    "test": "node --test",
    "types": "npx --yes --package typescript@5.7 tsc --noEmit -p tsconfig.json",
    "pack:check": "npm pack --dry-run"
  }
}
